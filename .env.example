# Local API port. Cloud Run injects PORT automatically in production.
SERVER_PORT=4000
# Production satellites require persistent storage, not container-local
# temporary storage. Set in the deployment environment; never put API keys here.
# ORBIT_CACHE_PATH=/persistent/aerogrid/orbits.json
# Cloud Run uses its existing service identity (no downloaded credentials).
# Both deployment regions must use the same bucket/object for refresh coordination.
# ORBIT_CACHE_PATH=gs://your-project-orbit-cache/orbits.json
# Aircraft budgets use sibling aircraft-budget/<provider>.json objects in that
# bucket automatically. Override only if ALL regions use the same private prefix.
# FLIGHT_BUDGET_PREFIX=gs://your-project-orbit-cache/aircraft-budget
# Production never uses an in-memory fallback. A missing ledger closes the
# current UTC day conservatively; see docs/DATA_SOURCES.md before migration.

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "../server-dist",
    "noEmit": false
  },
  "include": ["./**/*.ts", "../shared/contracts.ts"],
  "exclude": ["node_modules", "dist", "../server-dist", "**/*.test.ts"]
}
